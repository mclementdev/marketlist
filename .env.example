# URL du projet Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé publique (« anon » ou « publishable »). Utilisée par le navigateur
# uniquement pour s'abonner aux canaux Realtime Broadcast : grâce à la RLS sans
# policy, elle ne donne accès à aucune table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète (« service_role » ou « secret »). Côté serveur uniquement :
# ne jamais la préfixer par NEXT_PUBLIC_ ni la committer.
SUPABASE_SERVICE_ROLE_KEY=
